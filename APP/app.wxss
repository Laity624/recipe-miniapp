/**
 * 全局样式文件
 * 定义 CSS 变量和通用样式
 */

/* ==================== CSS 变量定义 ==================== */
page {
  /* 主色调 */
  --color-primary: #FF9F7F;
  --color-primary-dark: #E88D6E;
  --color-primary-light: rgba(255, 159, 127, 0.15);

  /* 背景色 */
  --bg-color: #FAFAF8;
  --card-bg: #FFFFFF;
  --bg-color-grey: #F5F5F5;

  /* 文字色 */
  --text-main: #333333;
  --text-sub: #666666;
  --text-light: #999999;
  --text-placeholder: #CCCCCC;

  /* 功能色 */
  --color-error: #FF6B6B;
  --color-warning: #FFC800;
  --color-link: #36A2EB;

  /* 圆角 */
  --radius-lg: 24rpx;
  --radius-base: 16rpx;
  --radius-sm: 8rpx;
  --radius-capsule: 999rpx;

  /* 阴影 */
  --shadow-level-1: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  --shadow-level-2: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-diffuse: 0 8rpx 20rpx rgba(255, 159, 127, 0.3);

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 字体大小 */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 40rpx;
}

/* ==================== 全局样式重置 ==================== */
page {
  height: 100vh;
  background-color: var(--bg-color);
  color: var(--text-sub);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  padding-bottom: calc(env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 清除默认样式 */
view, text, image, button {
  box-sizing: border-box;
}

/* ==================== 通用工具类 ==================== */

/* 布局 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-align-center {
  display: flex;
  align-items: center;
}

/* 文字 */
.text-main {
  color: var(--text-main);
}

.text-sub {
  color: var(--text-sub);
}

.text-light {
  color: var(--text-light);
}

.text-primary {
  color: var(--color-primary);
}

.text-center {
  text-align: center;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 卡片 */
.card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-level-1);
  overflow: hidden;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #FFFFFF;
  border-radius: var(--radius-capsule);
  box-shadow: var(--shadow-diffuse);
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
}

