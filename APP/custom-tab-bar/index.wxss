/* custom-tab-bar/index.wxss */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  display: flex;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  z-index: 9999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  transition: all 0.3s ease;
}

.tab-icon.active {
  transform: scale(1.15);
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  transition: all 0.3s ease;
}

.tab-text.active {
  color: #FF9F7F;
  font-weight: 600;
}
