/* pages/recipe/detail/detail.wxss */

.detail-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 120rpx;
}

/* ========== 图片轮播 ========== */
.image-swiper {
  width: 100%;
  height: 500rpx;
  background-color: var(--bg-grey);
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* ========== 基本信息卡片 ========== */
.info-card {
  background-color: var(--card-bg);
  margin: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.recipe-title {
  flex: 1;
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
  margin-right: 20rpx;
}

.favorite-btn {
  padding: 8rpx;
}

.heart-icon {
  font-size: 48rpx;
}

.description {
  display: block;
  font-size: var(--font-base);
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 标签行 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--bg-grey);
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background-color: var(--primary-light);
  border-radius: var(--radius-capsule);
}

.tag-label {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.tag-value {
  font-size: var(--font-sm);
  color: var(--primary-color);
  font-weight: 600;
}

/* 作者信息 */
.author-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.author-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: var(--bg-grey);
}

.author-name {
  font-size: var(--font-base);
  color: var(--text-main);
  font-weight: 600;
}

.publish-time {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--text-light);
}

/* ========== 通用区块卡片 ========== */
.section-card {
  background-color: var(--card-bg);
  margin: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 36rpx;
}

.title-text {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-main);
}

/* 食材/调料列表 */
.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: var(--bg-color);
  border-radius: var(--radius-base);
}

.ingredient-name {
  font-size: var(--font-base);
  color: var(--text-main);
}

.ingredient-amount {
  font-size: var(--font-sm);
  color: var(--text-light);
}

/* 步骤列表 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-number {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
  font-weight: 600;
}

.step-content {
  flex: 1;
}

.step-text {
  display: block;
  font-size: var(--font-base);
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.step-image {
  width: 100%;
  border-radius: var(--radius-base);
  margin-top: 16rpx;
}

/* 小技巧/注意事项 */
.tips-text {
  display: block;
  font-size: var(--font-base);
  color: var(--text-sub);
  line-height: 1.8;
  padding: 20rpx;
  background-color: var(--bg-color);
  border-radius: var(--radius-base);
  border-left: 6rpx solid var(--primary-color);
}

/* 链接列表 */
.links-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.link-item {
  font-size: var(--font-sm);
  color: var(--primary-color);
  text-decoration: underline;
  word-break: break-all;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: var(--card-bg);
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.btn-icon {
  font-size: 40rpx;
}

.btn-text {
  font-size: var(--font-xs);
  color: var(--text-sub);
}

