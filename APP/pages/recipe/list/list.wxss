/* pages/recipe/list/list.wxss */

.list-page {
  min-height: 100vh;
  background-color: var(--bg-color);
}

/* ========== Tab 切换 ========== */
.tabs {
  display: flex;
  background-color: var(--card-bg);
  padding: 0 24rpx;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 32rpx 0;
  font-size: var(--font-base);
  color: var(--text-sub);
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  border-radius: 3rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background-color: var(--color-error);
  color: #ffffff;
  font-size: var(--font-xxs);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 列表内容 ========== */
.content {
  padding: 24rpx;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recipe-item {
  display: flex;
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.item-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow-base);
}

.recipe-image {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background-color: var(--bg-grey);
}

.recipe-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.recipe-desc {
  font-size: var(--font-sm);
  color: var(--text-light);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.recipe-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.status-tag {
  margin-left: auto;
  padding: 6rpx 16rpx;
  background-color: var(--color-warning);
  color: #ffffff;
  font-size: var(--font-xxs);
  border-radius: var(--radius-capsule);
}

.status-tag.private {
  background-color: var(--text-light);
}

.action-btn {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-color);
}

.action-icon {
  font-size: 48rpx;
  color: var(--text-light);
  font-weight: 300;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: var(--font-base);
  color: var(--text-light);
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #ffffff;
  font-size: var(--font-base);
  border-radius: var(--radius-capsule);
  box-shadow: var(--shadow-diffuse);
}

