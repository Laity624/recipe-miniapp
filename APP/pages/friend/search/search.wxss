/* pages/friend/search/search.wxss */

.search-page {
  min-height: 100vh;
  background-color: var(--bg-color);
}

/* ========== 搜索框 ========== */
.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background-color: var(--card-bg);
  box-shadow: var(--shadow-sm);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: var(--bg-color);
  border-radius: var(--radius-capsule);
  padding: 20rpx 28rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-main);
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
  background-color: var(--text-placeholder);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 300;
  margin-left: 16rpx;
}

.search-btn {
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #ffffff;
  font-size: var(--font-base);
  border-radius: var(--radius-capsule);
}

/* ========== 搜索提示 ========== */
.search-tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.tips-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.tips-text {
  font-size: var(--font-base);
  color: var(--text-light);
}

/* ========== 搜索结果 ========== */
.search-result {
  padding: 24rpx;
}

.user-card {
  background-color: var(--card-bg);
  padding: 40rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: var(--bg-grey);
  margin-bottom: 24rpx;
}

.user-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.user-name {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-main);
}

.user-code {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background-color: var(--bg-grey);
  border-radius: var(--radius-sm);
}

.code-label {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.code-value {
  font-size: var(--font-sm);
  color: var(--text-main);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.user-bio {
  font-size: var(--font-sm);
  color: var(--text-sub);
  text-align: center;
  line-height: 1.6;
}

.user-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-item {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.stat-divider {
  color: var(--text-placeholder);
}

/* 操作按钮 */
.action-area {
  width: 100%;
}

.add-btn,
.pending-btn,
.friend-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: var(--radius-capsule);
  text-align: center;
  font-size: var(--font-base);
  font-weight: 600;
}

.add-btn {
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #ffffff;
  box-shadow: var(--shadow-diffuse);
}

.pending-btn {
  background-color: var(--bg-grey);
  color: var(--text-light);
}

.friend-btn {
  background-color: var(--color-success);
  color: #ffffff;
}

/* 未找到 */
.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.not-found-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.not-found-text {
  font-size: var(--font-lg);
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.not-found-hint {
  font-size: var(--font-sm);
  color: var(--text-light);
}

/* ========== 搜索历史 ========== */
.search-history {
  padding: 24rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: var(--font-base);
  color: var(--text-main);
  font-weight: 600;
}

.clear-history {
  font-size: var(--font-sm);
  color: var(--text-light);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background-color: var(--card-bg);
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-sm);
}

.history-icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.history-text {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-sub);
}

