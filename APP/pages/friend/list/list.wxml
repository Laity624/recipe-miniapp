<!--pages/friend/list/list.wxml-->
<view class="friend-list-page">
  
  <!-- Tab 切换 -->
  <view class="tabs">
    <view 
      class="tab-item {{activeTab === 0 ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="0"
    >
      <text>好友列表</text>
      <view class="tab-badge" wx:if="{{friendCount > 0}}">{{friendCount}}</view>
    </view>
    <view 
      class="tab-item {{activeTab === 1 ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="1"
    >
      <text>好友申请</text>
      <view class="tab-badge" wx:if="{{requestCount > 0}}">{{requestCount}}</view>
    </view>
  </view>

  <!-- 好友列表 -->
  <view class="content" wx:if="{{activeTab === 0}}">
    <view class="friend-list" wx:if="{{friendList.length > 0}}">
      <view
        class="friend-item"
        wx:for="{{friendList}}"
        wx:key="_openid"
        bindtap="viewFriendRecipes"
        data-friend="{{item}}"
        hover-class="item-hover"
      >
        <image class="friend-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view class="friend-info">
          <text class="friend-name">{{item.nickname}}</text>
          <text class="friend-bio">{{item.bio || '这个人很懒，什么都没写~'}}</text>
          <view class="friend-stats">
            <text class="stat-text">菜谱 {{item.recipeCount || 0}}</text>
            <text class="stat-divider">·</text>
            <text class="stat-text">获赞 {{item.favoriteCount || 0}}</text>
          </view>
        </view>
        <view class="action-btn" catchtap="showFriendAction" data-friend="{{item}}">
          <text class="action-icon">⋮</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-icon">👥</text>
      <text class="empty-text">还没有好友</text>
      <view class="empty-btn" bindtap="searchFriend">添加好友</view>
    </view>
  </view>

  <!-- 好友申请 -->
  <view class="content" wx:if="{{activeTab === 1}}">
    <view class="request-list" wx:if="{{requestList.length > 0}}">
      <view class="request-item" wx:for="{{requestList}}" wx:key="_id">
        <image class="request-avatar" src="{{item.userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="request-info">
          <text class="request-name">{{item.userInfo.nickname}}</text>
          <text class="request-time">{{item.createTimeText}}</text>
        </view>
        <view class="request-actions">
          <view class="btn-reject" bindtap="handleRequest" data-request="{{item}}" data-action="reject">拒绝</view>
          <view class="btn-accept" bindtap="handleRequest" data-request="{{item}}" data-action="accept">同意</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无好友申请</text>
    </view>
  </view>

  <!-- 悬浮添加按钮 -->
  <view class="fab-btn" bindtap="searchFriend" hover-class="fab-hover">
    <text class="plus-icon">＋</text>
  </view>

</view>

