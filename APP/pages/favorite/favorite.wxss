/* pages/favorite/favorite.wxss */

.favorite-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
}

/* ========== 顶部统计 ========== */
.stats-bar {
  padding: 24rpx 32rpx 16rpx;
  background-color: var(--card-bg);
}

.stats-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* ========== 搜索框 ========== */
.search-bar {
  background-color: var(--card-bg);
  padding: 0 16rpx 16rpx;
}

/* ========== 收藏列表 ========== */
.favorite-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.favorite-item {
  display: flex;
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-level-1);
  transition: all 0.2s;
  position: relative;
}

.item-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow-level-2);
}

/* ========== 菜谱图片 ========== */
.recipe-image-wrapper {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  position: relative;
}

.recipe-image {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.recipe-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mask-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

/* ========== 菜谱信息 ========== */
.recipe-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.recipe-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 4rpx 12rpx;
  background-color: var(--bg-color);
  color: var(--text-sub);
  font-size: 24rpx;
  border-radius: 8rpx;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.author-name {
  font-size: 24rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.favorite-time {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

/* ========== 操作按钮 ========== */
.action-btn {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-color);
  flex-shrink: 0;
}

.heart-icon {
  font-size: 56rpx;
}

/* ========== 加载状态 ========== */
.loading-more {
  padding: 40rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.no-more {
  padding: 40rpx 0;
  text-align: center;
  color: var(--text-light);
  font-size: 28rpx;
}

/* ========== 空状态 ========== */
.empty-wrapper {
  padding: 120rpx 0;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 48rpx;
  display: inline-block;
  margin-top: 24rpx;
}
