/* pages/mine/mine.wxss */

.mine-page {
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ========== 个人信息卡片 ========== */
.header-card {
  background-color: var(--card-bg);
  margin: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background-color: var(--bg-grey);
  margin-right: 24rpx;
  border: 2px solid #f8f6f6;
}

.info {
  flex: 1;
}

/* 设置按钮 */
.setting-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--bg-color);
  border-radius: 50%;
  margin-left: 16rpx;
  transition: all 0.2s;
}

.setting-btn-hover {
  background-color: var(--color-primary);
  transform: scale(0.95);
}

.setting-icon {
  font-size: 36rpx;
}

.nickname {
  display: block;
  font-size: var(--font-xxl);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.identity-code-box {
  display: flex;
  align-items: center;
  background-color: var(--bg-grey);
  border-radius: var(--radius-sm);
  width: fit-content;
}

.identity-label {
  font-size: var(--font-sm);
  color: var(--text-main);
  margin-right: 8rpx;
}

.identity-code {
  font-size: var(--font-sm);
  color: var(--text-main);
  /* font-weight: 600; */
  letter-spacing: 2rpx;
}

.bio {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 40rpx;
  margin-left: 30rpx;
  white-space: pre-wrap;  /* 保留换行符和空格 */
  word-wrap: break-word;  /* 长单词自动换行 */
}

/* 统计数据 */
.stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1rpx solid var(--bg-grey);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: var(--font-xs);
  color: var(--text-light);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: var(--bg-grey);
}

/* ========== 功能菜单 ========== */
.menu-section {
  background-color: var(--card-bg);
  margin: 24rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--bg-grey);
  transition: background-color 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-hover {
  background-color: var(--bg-grey);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 40rpx;
}

.menu-title {
  font-size: var(--font-base);
  color: var(--text-main);
}

.menu-arrow {
  font-size: 48rpx;
  color: var(--text-placeholder);
  font-weight: 300;
}

/* ========== 底部 ========== */
.footer {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.version {
  font-size: var(--font-xs);
  color: var(--text-placeholder);
}

/* ========== 管理员徽章 ========== */
.admin-badge {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-md);
  background: linear-gradient(135deg, #FFD700, #FFA500);
  border-radius: var(--radius-base) var(--radius-base) 0 0;
}

.badge-icon {
  font-size: 28rpx;
}

.badge-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

