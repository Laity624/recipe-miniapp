/* pages/index/index.wxss */

.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ========== 1. 吸顶头部 ========== */
.sticky-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: var(--bg-color);
  padding: 20rpx 24rpx 16rpx;
}

/* 搜索栏 */
.search-bar-box {
  margin-bottom: 20rpx;
}

.search-input-bg {
  display: flex;
  align-items: center;
  background-color: var(--card-bg);
  border-radius: var(--radius-base);
  padding: 20rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: var(--font-base);
  color: var(--text-main);
}

.placeholder-style {
  color: var(--text-placeholder);
}

/* 筛选标签 */
.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
}

.filter-tag {
  display: inline-block;
  padding: 14rpx 28rpx;
  background-color: var(--card-bg);
  color: var(--text-sub);
  font-size: var(--font-sm);
  border-radius: var(--radius-capsule);
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
}

.filter-tag.active {
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  color: #ffffff;
  box-shadow: var(--shadow-diffuse);
  font-weight: 600;
}

/* 占位符 */
.header-placeholder {
  height: 200rpx;
}

/* ========== 2. 瀑布流布局 ========== */
.waterfall-container {
  display: flex;
  gap: 20rpx;
  padding-bottom: 120rpx;
}

.column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 菜谱卡片 */
.recipe-card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.card-hover {
  transform: scale(0.98);
  box-shadow: var(--shadow-base);
}

.image-wrapper {
  position: relative;
  width: 100%;
}

.recipe-img {
  width: 100%;
  display: block;
  background-color: var(--bg-grey);
}

.info-tag-overlay {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-tag-overlay text {
  font-size: var(--font-xxs);
  color: #ffffff;
}

.card-content {
  padding: 24rpx 20rpx;
}

.recipe-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.5;
  margin-bottom: 20rpx;
  text-align: justify;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.author-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: var(--bg-grey);
}

.author-name {
  font-size: var(--font-sm);
  color: var(--text-light);
}

.like-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.heart-icon {
  font-size: 28rpx;
}

.like-count {
  font-size: var(--font-sm);
  color: var(--text-light);
}

/* ========== 3. 悬浮按钮 ========== */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF9F7F, #FF8E66);
  border-radius: 50%;
  box-shadow: var(--shadow-diffuse);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  transition: all 0.3s ease;
}

.fab-hover {
  transform: scale(0.9);
}

.plus-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}

/* ========== 4. 底部提示 ========== */
.loading-text {
  text-align: center;
  padding: 40rpx 0 60rpx;
  font-size: var(--font-xs);
  color: var(--text-light);
  letter-spacing: 2rpx;
}

